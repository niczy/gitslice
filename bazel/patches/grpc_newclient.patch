+package grpc
+
+import "context"
+
+// NewClient creates a client connection to the given target.
+//
+// This provides compatibility for grpc-gateway generated code expecting
+// grpc.NewClient while using older grpc-go releases.
+func NewClient(target string, opts ...DialOption) (*ClientConn, error) {
+	return DialContext(context.Background(), target, opts...)
+}
