load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "gs_cli_lib",
    srcs = [
        "cache.go",
        "checkout_parallel.go",
        "commands_changeset.go",
        "commands_conflict.go",
        "commands_misc.go",
        "commands_slice.go",
        "help.go",
        "main.go",
        "metadata.go",
        "utils.go",
    ],
    importpath = "github.com/niczy/gitslice/gs_cli",
    deps = [
        "//internal/common",
        "//proto/admin:admin_go",
        "//proto/slice:slice_go",
        "@org_golang_google_grpc//:go_default_library",
        "@org_golang_google_grpc//credentials/insecure:go_default_library",
    ],
)

go_binary(
    name = "gs_cli",
    embed = [":gs_cli_lib"],
)

go_test(
    name = "gs_cli_test",
    srcs = [
        "cache_test.go",
        "checkout_parallel_test.go",
    ],
    embed = [":gs_cli_lib"],
)
