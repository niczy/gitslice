# Backend API base URL used by the web app (optional in local dev with Vite proxy).
VITE_FILE_API_BASE_URL=

# Optional API proxy target for Vite dev/preview.
VITE_FILE_API_PROXY_TARGET=http://localhost:8080

# Auth.js configuration for OAuth sign-in.
AUTH_SECRET=replace-with-long-random-string
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret
AUTH_GITHUB_ID=your-github-oauth-client-id
AUTH_GITHUB_SECRET=your-github-oauth-client-secret
# Optional; defaults to "read:user user:email"
AUTH_GITHUB_SCOPE=read:user user:email
