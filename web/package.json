{
  "name": "gitslice-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "preview": "react-router-serve ./build/server/index.js",
    "dev:worker": "npm run build && wrangler dev --config wrangler.jsonc --env staging --local --port 4174",
    "preview:worker": "npm run build && wrangler deploy --config wrangler.jsonc --env staging --dry-run",
    "deploy:worker:staging": "npm run build && wrangler deploy --config wrangler.jsonc --env staging",
    "deploy:worker:production": "npm run build && wrangler deploy --config wrangler.jsonc --env production",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@clerk/backend": "^3.4.2",
    "@clerk/react": "^6.4.7",
    "@clerk/react-router": "^3.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-router/cloudflare": "7.13.2",
    "@react-router/node": "7.13.2",
    "@react-router/serve": "7.13.2",
    "@tanstack/react-query": "^5.90.21",
    "@workos-inc/node": "^8.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5.1.31",
    "lucide-react": "^0.575.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.13.2",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260329.1",
    "@playwright/test": "^1.57.0",
    "@react-router/dev": "7.13.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "vite": "^7.1.7",
    "wrangler": "4.78.0"
  }
}
