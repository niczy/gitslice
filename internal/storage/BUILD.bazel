        "objectstore.go",
        "redis.go",
        "storage.go",
    ],
    importpath = "github.com/niczy/gitslice/internal/storage",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/models",
        "@com_github_aws_aws_sdk_go_v2_service_s3//:go_default_library",
