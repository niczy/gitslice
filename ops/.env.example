# Deployment environment for gitslice services.
# Copy to ops/.env.production for production, or to ops/.env.staging for staging.
# For staging, change:
#   DEPLOY_ENV=staging
#   CORE_SERVICE_PORT=50052
#   PUBLIC_WEB_BASE_URL=https://agenttools.dev
#   PUBLIC_API_BASE_URL=https://api.agenttools.dev
#   R2_BUCKET / R2_PREFIX to the staging namespace
# The ops scripts and PM2 ecosystem read ops/.env.production and
# ops/.env.staging as the canonical deployment env files.

# Environment identity
DEPLOY_ENV=production

# Core listener / split-host URLs
CORE_BIND_ADDR=127.0.0.1
CORE_SERVICE_PORT=50051
PUBLIC_WEB_BASE_URL=https://gitslice.io
PUBLIC_API_BASE_URL=https://api.gitslice.io
# Optional override for the web runtime API base URL.
# Leave blank to inherit PUBLIC_API_BASE_URL.
VITE_FILE_API_BASE_URL=

# Web runtime target metadata
WEB_DEPLOY_TARGET=cloudflare_worker
WEB_COMPAT_RUNTIME=worker
RUN_WEB_SSR=0

# Core metadata database
STORAGE_TYPE=postgres
POSTGRES_DSN=postgres://user:pass@127.0.0.1:5432/gitslice?sslmode=disable
POSTGRES_MAX_CONNS=64
POSTGRES_MIN_CONNS=4
POSTGRES_MAX_CONN_LIFETIME=30m

# Human auth provider
AUTH_PROVIDER=clerk
AUTH_SECRET=
ALLOW_DEV_LOGIN=
ALLOW_LEGACY_USER_AUTH=
# Comma-separated or JSON array of emails allowed to use restricted /admin APIs.
ADMIN_USER_EMAILS=

# Clerk auth
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=

# Object storage
# Production and staging should use separate R2 namespaces.
OBJECT_STORE_TYPE=r2
OBJECT_STORE_DIR=/home/<user>/workspace/gitslice/.objectstore
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET=gitslice-production
R2_PREFIX=production
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_USE_PATH_STYLE=false

# Web SSR process
# Only used when RUN_WEB_SSR=1 for a local Node SSR fallback.
WEB_HOST=127.0.0.1
WEB_PORT=4173
