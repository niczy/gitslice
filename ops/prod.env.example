STORAGE_TYPE=postgres
# Set this to your managed Postgres DSN in production.
# If omitted, ops/start_web_server.sh bootstraps a local Postgres instance.
POSTGRES_DSN=

OBJECT_STORE_TYPE=filesystem
OBJECT_STORE_DIR=/home/nic/workspace/gitslice/.objectstore

# GCS-backed object store options (used when OBJECT_STORE_TYPE=gcs).
GCS_BUCKET=gitslice-objects
GCS_ENDPOINT=
GCS_CREDENTIALS_FILE=
GCS_CREDENTIALS_JSON=
GCS_DISABLE_AUTH=false
